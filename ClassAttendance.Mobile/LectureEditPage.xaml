<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClassAttendance.Mobile.LectureEditPage"
             Title="Edit lecture">
    <ScrollView>
        <VerticalStackLayout Padding="24,40,24,24" Spacing="16">
            <Label Text="Edit lecture" Style="{StaticResource ScreenTitle}" />
            <Label x:Name="LectureSubjectLabel" Style="{StaticResource Subtitle}" />
            <DatePicker x:Name="LectureDatePicker" Format="dd-MM-yyyy" />
            <TimePicker x:Name="LectureStartTimePicker" Format="HH:mm" />
            <TimePicker x:Name="LectureEndTimePicker" Format="HH:mm" />
            <Border Style="{StaticResource LoginFieldBorder}">
                <Entry x:Name="LectureRoomEntry" Placeholder="Room" Margin="17,0" />
            </Border>
            <Button Text="Save"
                    Clicked="OnSaveClicked"
                    Style="{StaticResource PrimaryActionButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
