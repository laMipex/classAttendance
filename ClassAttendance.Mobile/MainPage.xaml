<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClassAttendance.Mobile.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">
    <Grid>
        <Image Source="login_background.svg"
               IsVisible="{Binding IsLoginVisible}"
               Aspect="AspectFill" />

        <ScrollView IsVisible="{Binding IsLoginVisible}">
            <VerticalStackLayout WidthRequest="360"
                                 HorizontalOptions="Center"
                                 Padding="30,80,30,40"
                                 Spacing="17">
                <Image Source="vts_logo.jpg"
                       HeightRequest="150"
                       Aspect="AspectFit"
                       Margin="0,16,0,52"
                       SemanticProperties.Description="VTS logo" />
                <Border Style="{StaticResource LoginFieldBorder}">
                    <Entry x:Name="IndexEntry"
                           Placeholder="Index"
                           Keyboard="Numeric"
                           MaxLength="8"
                           FontSize="24"
                           Margin="17,0" />
                </Border>
                <Border Style="{StaticResource LoginFieldBorder}">
                    <Entry x:Name="EmailEntry"
                           Placeholder="Email"
                           Keyboard="Email"
                           FontSize="24"
                           Margin="17,0" />
                </Border>
                <Border Style="{StaticResource LoginFieldBorder}">
                    <Entry x:Name="PasswordEntry"
                           Placeholder="Password"
                           IsPassword="True"
                           FontSize="24"
                           Margin="17,0" />
                </Border>
                <Label x:Name="ValidationMessage"
                       TextColor="#B42318"
                       FontSize="14"
                       IsVisible="False" />
                <Button Text="Login"
                        Clicked="OnLoginClicked"
                        Style="{StaticResource PrimaryActionButton}"
                        Margin="0,26,0,0" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid IsVisible="{Binding IsAppVisible}"
              RowDefinitions="*,72"
              BackgroundColor="#F7FAFC">
            <Grid Grid.Row="0">
                <ScrollView IsVisible="{Binding IsDashboardVisible}">
                    <VerticalStackLayout Padding="24,40,24,24" Spacing="18">
                        <Label Text="{Binding WelcomeText}" Style="{StaticResource ScreenTitle}" />
                        <Label Text="{Binding RoleDescription}" Style="{StaticResource Subtitle}" />

                        <Border Style="{StaticResource StatusCard}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding LessonStatusTitle}" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding LessonStatusDetail}" Style="{StaticResource CardBody}" />
                                <Label Text="{Binding LessonTime}" TextColor="#0798DE" FontFamily="RobotoBold" FontSize="16" />
                                <Label Text="{Binding AttendanceAvailabilityMessage}"
                                       IsVisible="{Binding IsStudent}"
                                       Style="{StaticResource CardBody}" />
                                <Button Text="{Binding AttendanceButtonText}"
                                        Clicked="OnAttendanceClicked"
                                        IsVisible="{Binding IsStudent}"
                                        IsEnabled="{Binding IsAttendanceCheckInOpen}"
                                        Style="{StaticResource PrimaryActionButton}"
                                        HorizontalOptions="Start"
                                        Margin="0,8,0,0" />
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout IsVisible="{Binding IsStudent}" Spacing="10">
                            <Label Text="Active quizzes" Style="{StaticResource SectionTitle}" />
                            <CollectionView ItemsSource="{Binding StudentQuizzes}" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ListCard}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnStudentQuizTapped" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <VerticalStackLayout Spacing="3">
                                                    <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                                    <Label Text="{Binding Detail}" Style="{StaticResource CardBody}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" Text="›" FontSize="30" TextColor="#0798DE" VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding IsProfessor}" Spacing="10">
                            <Label Text="Quizzes" Style="{StaticResource SectionTitle}" />
                            <Button Text="+ Create a quiz"
                                    Clicked="OnCreateQuizClicked"
                                    Style="{StaticResource PrimaryActionButton}"
                                    HorizontalOptions="Start" />
                            <CollectionView ItemsSource="{Binding ProfessorQuizzes}" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ListCard}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnProfessorQuizTapped" />
                                            </Border.GestureRecognizers>
                                            <VerticalStackLayout Spacing="3">
                                                <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" />
                                                <Label Text="{Binding Detail}" Style="{StaticResource CardBody}" />
                                                <Label Text="{Binding VisibilityText}" TextColor="{Binding VisibilityColor}" FontSize="13" />
                                                <HorizontalStackLayout Spacing="8">
                                                    <Button Text="Hide/Show" Clicked="OnQuizVisibilityClicked" Style="{StaticResource TextActionButton}" />
                                                    <Button Text="Delete" Clicked="OnDeleteQuizClicked" Style="{StaticResource TextActionButton}" TextColor="#B42318" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>

                <ScrollView IsVisible="{Binding IsScheduleVisible}">
                    <VerticalStackLayout Padding="24,40,24,24" Spacing="14">
                        <Label Text="Schedule" Style="{StaticResource ScreenTitle}" />
                        <Label Text="{Binding ScheduleDescription}" Style="{StaticResource Subtitle}" />
                        <CollectionView ItemsSource="{Binding ScheduleItems}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ListCard}">
                                        <Grid ColumnDefinitions="68,*">
                                            <VerticalStackLayout>
                                                <Label Text="{Binding Time}" TextColor="#0798DE" FontFamily="RobotoBold" FontSize="16" />
                                                <Label Text="{Binding Day}" Style="{StaticResource CardBody}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                                <Label Text="{Binding Subject}" Style="{StaticResource CardTitle}" />
                                                <Label Text="{Binding Detail}" Style="{StaticResource CardBody}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <VerticalStackLayout IsVisible="{Binding IsProfessor}" Spacing="10">
                            <Label Text="Manage schedule" Style="{StaticResource SectionTitle}" />
                            <CollectionView ItemsSource="{Binding EditableLectures}" SelectionMode="None">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ListCard}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <VerticalStackLayout Spacing="3">
                                                    <Label Text="{Binding SubjectName}" Style="{StaticResource CardTitle}" />
                                                    <Label Text="{Binding StartsAt, StringFormat='{0:dd-MM-yyyy HH:mm}'}"
                                                           Style="{StaticResource CardBody}" />
                                                    <Label Text="{Binding Room}" Style="{StaticResource CardBody}" />
                                                </VerticalStackLayout>
                                                <Button Grid.Column="1" Text="Edit"
                                                        Clicked="OnEditLectureClicked"
                                                        Style="{StaticResource TextActionButton}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                            <Border IsVisible="{Binding IsLectureEditorVisible}" Style="{StaticResource StatusCard}">
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="Edit lecture" Style="{StaticResource CardTitle}" />
                                    <DatePicker x:Name="LectureDatePicker"
                                                Format="dd-MM-yyyy" />
                                    <TimePicker x:Name="LectureStartTimePicker"
                                                Format="HH:mm" />
                                    <TimePicker x:Name="LectureEndTimePicker"
                                                Format="HH:mm" />
                                    <Border Style="{StaticResource LoginFieldBorder}">
                                        <Entry x:Name="LectureRoomEntry"
                                               Placeholder="Room"
                                               Margin="17,0" />
                                    </Border>
                                    <HorizontalStackLayout Spacing="8">
                                        <Button Text="Save"
                                                Clicked="OnSaveLectureClicked"
                                                Style="{StaticResource PrimaryActionButton}" />
                                        <Button Text="Cancel"
                                                Clicked="OnCancelLectureClicked"
                                                Style="{StaticResource OutlineActionButton}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>

                <ScrollView IsVisible="{Binding IsProfileVisible}">
                    <VerticalStackLayout Padding="24,40,24,24" Spacing="18">
                        <Label Text="Profile" Style="{StaticResource ScreenTitle}" />
                        <Border Style="{StaticResource StatusCard}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="{Binding UserName}" Style="{StaticResource CardTitle}" FontSize="24" />
                                <Label Text="{Binding UserRole}" TextColor="#0798DE" FontFamily="RobotoBold" />
                                <Label Text="{Binding UserIdentifier}" Style="{StaticResource CardBody}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Style="{StaticResource ListCard}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Account" Style="{StaticResource CardTitle}" />
                                <Label Text="{Binding ProfileSummary}" Style="{StaticResource CardBody}" />
                            </VerticalStackLayout>
                        </Border>
                        <Button Text="Log out"
                                Clicked="OnLogoutClicked"
                                Style="{StaticResource OutlineActionButton}" />
                    </VerticalStackLayout>
                </ScrollView>

                <ScrollView IsVisible="{Binding IsQuizEditorVisible}">
                    <VerticalStackLayout Padding="24,40,24,24" Spacing="16">
                        <Button Text="‹ Back to dashboard"
                                Clicked="OnBackToDashboardClicked"
                                Style="{StaticResource TextActionButton}"
                                HorizontalOptions="Start" />
                        <Label Text="Create quiz" Style="{StaticResource ScreenTitle}" />
                        <Picker x:Name="QuizLecturePicker"
                                Title="Choose class"
                                ItemsSource="{Binding ProfessorLectures}"
                                ItemDisplayBinding="{Binding DisplayName}" />
                        <Border Style="{StaticResource LoginFieldBorder}">
                            <Entry x:Name="QuizTitleEntry" Placeholder="Quiz title" Margin="17,0" />
                        </Border>
                        <Border Style="{StaticResource LoginFieldBorder}" HeightRequest="120">
                            <Editor x:Name="QuizQuestionEntry" Placeholder="Question" Margin="12,6" />
                        </Border>
                        <Picker x:Name="QuizTypePicker" Title="Answer type">
                            <Picker.Items>
                                <x:String>Text</x:String>
                                <x:String>Choice</x:String>
                            </Picker.Items>
                        </Picker>
                        <Border Style="{StaticResource LoginFieldBorder}">
                            <Entry x:Name="QuizOptionsEntry" Placeholder="Options, separated by commas" Margin="17,0" />
                        </Border>
                        <Button Text="Publish quiz"
                                Clicked="OnPublishQuizClicked"
                                Style="{StaticResource PrimaryActionButton}" />
                    </VerticalStackLayout>
                </ScrollView>

                <ScrollView IsVisible="{Binding IsQuizAnswerVisible}">
                    <VerticalStackLayout Padding="24,40,24,24" Spacing="16">
                        <Button Text="‹ Back to dashboard"
                                Clicked="OnBackToDashboardClicked"
                                Style="{StaticResource TextActionButton}"
                                HorizontalOptions="Start" />
                        <Label Text="{Binding ActiveQuestion.Text}" Style="{StaticResource ScreenTitle}" />
                        <Border IsVisible="{Binding IsTextAnswerVisible}" Style="{StaticResource LoginFieldBorder}" HeightRequest="140">
                            <Editor Text="{Binding AnswerText}" Placeholder="Your answer" Margin="12,6" />
                        </Border>
                        <Picker IsVisible="{Binding IsChoiceAnswerVisible}"
                                ItemsSource="{Binding ActiveOptions}"
                                SelectedItem="{Binding SelectedOption}"
                                ItemDisplayBinding="{Binding Text}"
                                Title="Choose an answer" />
                        <Button Text="Submit answer"
                                Clicked="OnSubmitQuizClicked"
                                Style="{StaticResource PrimaryActionButton}" />
                    </VerticalStackLayout>
                </ScrollView>

                <ScrollView IsVisible="{Binding IsQuizResponsesVisible}">
                    <VerticalStackLayout Padding="24,40,24,24" Spacing="16">
                        <Button Text="‹ Back to dashboard"
                                Clicked="OnBackToDashboardClicked"
                                Style="{StaticResource TextActionButton}"
                                HorizontalOptions="Start" />
                        <Label Text="{Binding ActiveQuizTitle}" Style="{StaticResource ScreenTitle}" />
                        <CollectionView ItemsSource="{Binding ActiveQuizResponses}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ListCard}">
                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="{Binding Text}" Style="{StaticResource CardTitle}" />
                                            <CollectionView ItemsSource="{Binding Responses}" SelectionMode="None">
                                                <CollectionView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                            <Label Text="{Binding StudentIndex}" Style="{StaticResource CardTitle}" />
                                                            <Label Grid.Column="1" Text="{Binding DisplayAnswer}" Style="{StaticResource CardBody}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </CollectionView.ItemTemplate>
                                            </CollectionView>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <Grid Grid.Row="1" BackgroundColor="White" ColumnDefinitions="*,*,*" Padding="16,8">
                <Button Text="Home" Clicked="OnDashboardClicked" Style="{StaticResource NavigationButton}" />
                <Button Grid.Column="1" Text="Schedule" Clicked="OnScheduleClicked" Style="{StaticResource NavigationButton}" />
                <Button Grid.Column="2" Text="Profile" Clicked="OnProfileClicked" Style="{StaticResource NavigationButton}" />
            </Grid>
        </Grid>

        <Grid IsVisible="{Binding IsLoginSubmitting}" BackgroundColor="#80FFFFFF">
            <ActivityIndicator IsRunning="{Binding IsLoginSubmitting}"
                               Color="#0798DE"
                               WidthRequest="64"
                               HeightRequest="64"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
