<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ClassAttendance.Mobile.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="White">
    <Grid>
        <Image Source="login_background.svg"
               IsVisible="{Binding IsLoginVisible}"
               Aspect="AspectFill" />

        <ScrollView IsVisible="{Binding IsLoginVisible}">
            <VerticalStackLayout WidthRequest="360"
                                 HorizontalOptions="Center"
                                 Padding="30,80,30,40"
                                 Spacing="17">
                <Image Source="vts_logo.jpg"
                       HeightRequest="150"
                       Aspect="AspectFit"
                       Margin="0,16,0,52"
                       SemanticProperties.Description="VTS logo" />

                <Border Stroke="#303030"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        HeightRequest="64">
                    <Entry x:Name="IndexEntry"
                           Placeholder="Index"
                           Keyboard="Numeric"
                           MaxLength="8"
                           FontSize="26"
                           Margin="17,0" />
                </Border>

                <Border Stroke="#303030"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        HeightRequest="64">
                    <Entry x:Name="EmailEntry"
                           Placeholder="Email"
                           Keyboard="Email"
                           FontSize="26"
                           Margin="17,0" />
                </Border>

                <Border Stroke="#303030"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 10"
                        HeightRequest="64">
                    <Entry x:Name="PasswordEntry"
                           Placeholder="Password"
                           IsPassword="True"
                           FontSize="26"
                           Margin="17,0" />
                </Border>

                <Label x:Name="ValidationMessage"
                       TextColor="#B42318"
                       FontSize="14"
                       IsVisible="False"
                       LineBreakMode="WordWrap" />

                <Button x:Name="LoginButton"
                        Text="Login"
                        Clicked="OnLoginClicked"
                        BackgroundColor="#0798DE"
                        TextColor="White"
                        FontFamily="RobotoBold"
                        FontSize="20"
                        CornerRadius="28"
                        HeightRequest="54"
                        WidthRequest="140"
                        HorizontalOptions="Center"
                        Margin="0,26,0,0" />
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout IsVisible="{Binding IsHomeVisible}"
                             Padding="22,52"
                             Spacing="0">
            <HorizontalStackLayout Spacing="8">
                <Label Text="Welcome"
                       FontSize="30"
                       TextColor="Black" />
                <Label x:Name="UserIdentifierLabel"
                       FontSize="30"
                       TextColor="#008FE0" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <Grid IsVisible="{Binding IsLoginSubmitting}"
              BackgroundColor="#80FFFFFF">
            <ActivityIndicator IsRunning="{Binding IsLoginSubmitting}"
                               IsVisible="{Binding IsLoginSubmitting}"
                               Color="#0798DE"
                               WidthRequest="64"
                               HeightRequest="64"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>